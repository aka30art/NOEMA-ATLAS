{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA ATLAS Collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "code",
    "promptIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "promptIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    }
  }
}