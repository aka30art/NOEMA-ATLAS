{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA ATLAS Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domainId",
    "description",
    "tags",
    "prompt",
    "status",
    "visibility",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domainId": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "collectionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modelCompatibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    }
  }
}